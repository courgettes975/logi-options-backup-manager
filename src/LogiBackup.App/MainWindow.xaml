<Window x:Class="LogiBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogiBackup.App"
        Title="Logi Options+ Backup Manager" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="6" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <TabControl>
            <!-- ================= Analyse ================= -->
            <TabItem Header="1. Analyse">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Lecture seule. Détecte la version de Logi Options+, l'emplacement et le format des réglages, les périphériques, les processus et services." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Analyser ce PC" Command="{Binding DetectCommand}" />
                    </StackPanel>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource RowTemplate}" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SettingsKeys}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="130" />
                            <DataGridTextColumn Header="Clé de settings.db" Binding="{Binding Key}" Width="*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= Sauvegarde ================= -->
            <TabItem Header="2. Sauvegarder">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Crée une archive .logibak avec les réglages portables et un manifeste (versions, périphériques, empreintes SHA-256). Les jetons du compte Logitech, chiffrés par Windows, ne sont jamais copiés." />
                    <TextBlock Text="Fichier de sauvegarde" FontWeight="SemiBold" />
                    <DockPanel Margin="0,4,0,12">
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Command="{Binding BrowseBackupCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <CheckBox Content="Logi Options+ : profils, assignations des boutons et touches, applications, préférences" IsChecked="{Binding BackupOptionsPlus}" />
                    <CheckBox Content="MX Creative Console : profils Keypad / Dialpad par application" IsChecked="{Binding BackupCreative}" />
                    <CheckBox Content="Médias personnalisés (icônes, sons)" IsChecked="{Binding BackupMedia}" />
                    <CheckBox Content="Préférences du Registre (HKCU\Software\Logitech\SharedSettings)" IsChecked="{Binding BackupRegistry}" />
                    <CheckBox Content="Plugins : dossiers installés et compilations des plugins de développement (.link), environ 150 Mo" IsChecked="{Binding BackupPlugins}" />
                    <CheckBox Content="Fermer Logi Options+ pendant la sauvegarde (facultatif, droits administrateur)" IsChecked="{Binding BackupStopProcesses}" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Sauvegarder" Command="{Binding BackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ================= Restauration ================= -->
            <TabItem Header="3. Restaurer">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Avant de restaurer sur un nouveau PC : installez Logi Options+, lancez-le une fois et appairez vos périphériques. La restauration fusionne vos réglages avec ceux du PC : numéros de série, appairages et compte restent ceux du PC." />
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Analyser" Command="{Binding AnalyzeArchiveCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Ouvrir..." Command="{Binding BrowseArchiveCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding PreviewRows}" ItemTemplate="{StaticResource RowTemplate}" Margin="0,0,0,8" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding PreviewMessages}" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="880" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding PluginPlan}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="150" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plugin" Binding="{Binding Source.EntryName}" Width="220" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Source.Version}" Width="100" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="170" />
                            <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="5">
                        <WrapPanel>
                            <CheckBox Content="Options+" IsChecked="{Binding RestoreOptionsPlus}" Margin="0,4,16,4" />
                            <CheckBox Content="MX Creative Console" IsChecked="{Binding RestoreCreative}" Margin="0,4,16,4" />
                            <CheckBox Content="Médias" IsChecked="{Binding RestoreMedia}" Margin="0,4,16,4" />
                            <CheckBox Content="Registre" IsChecked="{Binding RestoreRegistry}" Margin="0,4,16,4" />
                            <CheckBox Content="Plugins" IsChecked="{Binding RestorePlugins}" Margin="0,4,16,4" />
                            <CheckBox Content="Remplacer les plugins déjà installés" IsChecked="{Binding ReplaceExistingPlugins}"
                                      IsEnabled="{Binding RestorePlugins}" Margin="0,4,16,4" />
                        </WrapPanel>
                        <CheckBox Content="Restauration complète (retour arrière sur le même PC et le même compte uniquement)"
                                  IsChecked="{Binding RestoreFull}" IsEnabled="{Binding Preview.SameAccount, FallbackValue=False}" />
                        <CheckBox Content="Forcer malgré un schéma de settings.db différent (déconseillé)"
                                  IsChecked="{Binding ForceSchema}"
                                  Visibility="{Binding Preview.SchemaMismatch, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Restaurer" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Row="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Ouvrir le dossier de l'application" Command="{Binding OpenLogFolderCommand}" Margin="0" />
                <TextBlock Text="Journal" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
